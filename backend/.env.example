# ============================================================================
# MarkPro — backend environment
# Copy to .env and fill in. Never commit .env.
# Only the CORE block is required to boot; every integration block is optional
# and its module degrades gracefully when the keys are absent.
# ============================================================================

# ── Core (required) ─────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://localhost:27017/markpro
# Public URL of the React app. Used for OAuth callbacks, Stripe redirect URLs
# and password-reset links. This is THE canonical name — CLIENT_URL and
# SITE_URL are no longer read anywhere (Section B.4).
FRONTEND_URL=http://localhost:3000
# Public URL of this API (used in webhook + OAuth callback URLs given to vendors)
APP_URL=http://localhost:5000
APP_NAME=MarkPro

# ── Auth / crypto (required) ────────────────────────────────────────────────
JWT_SECRET=replace-me-with-64-random-hex-chars
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=replace-me-with-a-different-64-random-hex-chars
JWT_REFRESH_EXPIRE=30d
SESSION_SECRET=replace-me-with-32-random-hex-chars
# AES-256-GCM key for third-party credentials at rest (Section B.2).
# MUST be exactly 64 hex chars = 32 bytes:  openssl rand -hex 32
# Rotating this makes all previously stored credentials undecryptable.
TOKEN_ENCRYPTION_KEY=

# ── Social sign-in (Google / Apple) ─────────────────────────────────────────
# FREE. Google: console.cloud.google.com → APIs & Services → Credentials →
#   OAuth client ID → Web application. Paste the "Client ID" here.
# Apple: developer.apple.com (paid $99/yr program) → Identifiers → Services ID.
# Leave either blank and that button simply disappears from the login screen.
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# ── Cron / internal ─────────────────────────────────────────────────────────
# Shared bearer token required by POST /api/cron/* trigger endpoints
CRON_SECRET=
CACHE_TTL=3600
CURRENCY_CODE=USD
DB_TABLE_PREFIX=

# ── Seed admin (used once by npm run seed) ──────────────────────────────────
ADMIN_EMAIL=admin@markpro.local
ADMIN_PASSWORD=

# ── Billing: Stripe ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
# Section B.3: register exactly ONE endpoint in the Stripe Dashboard:
#   {APP_URL}/api/webhooks/stripe
# All modules (core plans, publish plans, aigen credits, socialai plans) are
# dispatched internally from it, so this one secret covers everything.
STRIPE_WEBHOOK_SECRET=

# ── Billing: PayPal ─────────────────────────────────────────────────────────
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# ── Email (SMTP is the default transport; SendGrid/Mailgun optional) ────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@markpro.local
SMTP_FROM_NAME=MarkPro
SENDGRID_API_KEY=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# ── AI providers ────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=dall-e-3
OPENAI_TTS_MODEL=tts-1
GEMINI_API_KEY=
MISTRAL_API_KEY=
STABILITY_API_KEY=
STABLE_DIFFUSION_MODEL=
DEFAULT_AI_MODEL=gpt-4o-mini
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
REMOVE_BG_API_KEY=
KINGSTUDIO_API_KEY=

# ── AI credit pricing (numbers; consumed by services/creditEngine.service) ──
PER_WORD_PRICING=1
IMAGE_PRICING_256=5
IMAGE_PRICING_512=10
IMAGE_PRICING_1024=20
IMAGE_ANIMATION_PRICING=50
TEXT_TO_SPEECH_PRICING=5
SPEECH_TO_TEXT_PRICING=5
BP_CREDIT_PER_POST=1
BP_AFFILIATE_COMMISSION_RATE=0.2

# ── Social OAuth: Facebook / Instagram ──────────────────────────────────────
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:5000/api/social/facebook/callback
FACEBOOK_ACCESS_TOKEN=
INSTAGRAM_ACCESS_TOKEN=

# ── Social OAuth: X / Twitter ───────────────────────────────────────────────
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_BEARER_TOKEN=
TWITTER_REDIRECT_URI=http://localhost:5000/api/social/twitter/callback

# ── Social OAuth: LinkedIn / TikTok / YouTube ───────────────────────────────
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:5000/api/social/linkedin/callback
TIKTOK_CLIENT_KEY=
TIKTOK_REDIRECT_URI=http://localhost:5000/api/social/tiktok/callback
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_REDIRECT_URI=http://localhost:5000/api/social/youtube/callback

# ── WhatsApp Cloud API ──────────────────────────────────────────────────────
WHATSAPP_API_TOKEN=
WHATSAPP_API_VERSION=v20.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WML_WEBHOOK_VERIFY_TOKEN=
CF_WEBHOOK_VERIFY_TOKEN=
# Baileys (unofficial WhatsApp) sidecar service
BAILEYS_SERVICE_URL=

# ── SMS / voice ─────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
VONAGE_API_KEY=
VONAGE_API_SECRET=

# ── SEO / link tooling ──────────────────────────────────────────────────────
PAGESPEED_API_KEY=
SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=
IPINFO_TOKEN=
BITLY_API_KEY=
REBRANDLY_API_KEY=
UNSPLASH_ACCESS_KEY=

# ── Object storage: S3-compatible ───────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=

# ── Object storage: Wasabi (alternative) ────────────────────────────────────
WASABI_ACCESS_KEY=
WASABI_SECRET_KEY=
WASABI_REGION=
WASABI_BUCKET=

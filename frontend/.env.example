# MarkPro — frontend environment. Copy to .env.local and fill in.
# Base URL of the MarkPro API. Socket.IO reuses this host (Section B.4:
# REACT_APP_SERVER_URL was removed in favour of this single variable).
REACT_APP_API_URL=http://localhost:5000/api

# ── Social sign-in (public values — safe in the browser bundle) ─────────────
# Must match GOOGLE_CLIENT_ID / APPLE_CLIENT_ID in the backend .env.
# Leave blank to hide that button.
REACT_APP_GOOGLE_CLIENT_ID=
REACT_APP_APPLE_CLIENT_ID=
# Apple requires an https redirect URL registered in the Apple portal.
# Defaults to <your site origin>/login when left blank.
REACT_APP_APPLE_REDIRECT_URI=
